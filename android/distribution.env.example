# Copy to distribution.env (not committed) and fill in.
# Firebase app ID of net.ymotongpoo.activitylog: Firebase console >
# Project settings > Your apps, or `firebase apps:list ANDROID --project <id>`.
FIREBASE_APP_ID=1:000000000000:android:0000000000000000000000
# Comma-separated App Distribution group aliases to distribute to.
FIREBASE_GROUPS=owner
