<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/categories_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <Button
        android:id="@+id/categories_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/categories_back" />

    <TextView
        style="@style/ScreenTitle"
        android:text="@string/section_categories" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/categories_help" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:id="@+id/categories_add"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/category_new" />
        <Button
            android:id="@+id/categories_manage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/categories_manage" />
    </LinearLayout>

    <EditText
        android:id="@+id/category_search"
        style="@style/Field"
        android:autofillHints=""
        android:inputType="text"
        android:singleLine="true"
        android:hint="@string/category_search" />

    <CheckBox
        android:id="@+id/category_unclassified"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/category_unclassified" />

    <TextView
        android:id="@+id/category_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/category_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp" />

    <ListView
        android:id="@+id/category_apps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
