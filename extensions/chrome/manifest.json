{
  "manifest_version": 3,
  "name": "activitylog",
  "version": "0.1.0",
  "description": "Reports the active tab and browser focus to the local activitylog agent (127.0.0.1).",
  "minimum_chrome_version": "120",
  "permissions": ["tabs", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "incognito": "spanning"
}
