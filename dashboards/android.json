{
  "title": "Android",
  "uid": "activitylog-android",
  "description": "Phone usage from the activitylog Android app: screen time, apps, unlocks and location.",
  "tags": [
    "activitylog",
    "android",
    "opentelemetry"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "5m",
  "links": [
    {
      "title": "activitylog",
      "type": "link",
      "url": "/d/activitylog-overview",
      "icon": "dashboard",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "prom",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 1,
        "regex": "/^grafanacloud-.+-prom$/",
        "skipUrlSync": false
      },
      {
        "name": "loki",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 1,
        "regex": "/^grafanacloud-.+-logs$/",
        "skipUrlSync": false
      },
      {
        "name": "tempo",
        "label": "Traces",
        "type": "datasource",
        "query": "tempo",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 1,
        "regex": "/^grafanacloud-.+-traces$/",
        "skipUrlSync": false
      },
      {
        "name": "device",
        "label": "Device",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prom}"
        },
        "query": "label_values(activity_time_seconds_total{job=\"activitylog/activitylog-android\"}, instance)",
        "definition": "label_values(activity_time_seconds_total{job=\"activitylog/activitylog-android\"}, instance)",
        "current": {},
        "hide": 0,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "options": [],
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Screen time",
      "description": "Time the device was in use (screen on and unlocked) in the selected range.",
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(increase(activity_time_seconds_total{job=\"activitylog/activitylog-android\", instance=~\"$device\", activity_state=\"active\"}[$__range]))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "type": "stat",
      "title": "Unlocks",
      "description": "Number of device unlocks in the selected range.",
      "id": 3,
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(increase(activity_device_unlocks_total{job=\"activitylog/activitylog-android\", instance=~\"$device\"}[$__range]))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "type": "stat",
      "title": "Screen time per unlock",
      "description": "Average screen time per unlock.",
      "id": 4,
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(increase(activity_time_seconds_total{job=\"activitylog/activitylog-android\", instance=~\"$device\", activity_state=\"active\"}[$__range])) / sum(increase(activity_device_unlocks_total{job=\"activitylog/activitylog-android\", instance=~\"$device\"}[$__range]))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "type": "stat",
      "title": "Apps used",
      "description": "Number of apps that were in the foreground for at least a minute.",
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "refId": "A",
          "editorMode": "code",
          "expr": "count(sum by (activity_app_id) (increase(activity_app_time_seconds_total{job=\"activitylog/activitylog-android\", instance=~\"$device\"}[$__range])) >= 60)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "type": "stat",
      "title": "App switches",
      "description": "activity.app.switch log events.",
      "id": 6,
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(count_over_time({service_name=\"activitylog-android\", service_instance_id=~\"${device:pipe}\"} | event_name=\"activity.app.switch\" [$__range]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "type": "stat",
      "title": "Location fixes",
      "description": "device.location log events. 0 when location recording is off.",
      "id": 7,
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(count_over_time({service_name=\"activitylog-android\", service_instance_id=~\"${device:pipe}\"} | event_name=\"device.location\" [$__range]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "teal"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "type": "timeseries",
      "title": "Screen time per hour by category",
      "description": "Foreground time per app category, per hour. The app sends metrics about every 15 minutes, so finer steps are not meaningful.",
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 16,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (activity_category) (increase(activity_category_time_seconds_total{job=\"activitylog/activitylog-android\", instance=~\"$device\"}[$__interval]))",
          "legendFormat": "{{activity_category}}",
          "range": true,
          "instant": false,
          "interval": "1h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "barAlignment": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never",
            "axisSoftMin": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1h"
    },
    {
      "type": "piechart",
      "title": "Categories",
      "description": "Share of foreground time per app category in the selected range.",
      "id": 9,
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 8,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (activity_category) (increase(activity_category_time_seconds_total{job=\"activitylog/activitylog-android\", instance=~\"$device\"}[$__range]))",
          "legendFormat": "{{activity_category}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "pieType": "donut",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        },
        "tooltip": {
          "mode": "single"
        },
        "displayLabels": []
      }
    },
    {
      "type": "row",
      "title": "Apps",
      "id": 10,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "bargauge",
      "title": "Top apps",
      "description": "Foreground time per app in the selected range (top 15).",
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 10,
        "h": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "refId": "A",
          "editorMode": "code",
          "expr": "sort_desc(topk(15, sum by (activity_app_name) (increase(activity_app_time_seconds_total{job=\"activitylog/activitylog-android\", instance=~\"$device\"}[$__range]))))",
          "legendFormat": "{{activity_app_name}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "continuous-BlPu"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "text",
        "showUnfilled": true,
        "namePlacement": "left",
        "sizing": "auto",
        "minVizHeight": 16,
        "maxVizHeight": 24,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Top apps per hour",
      "description": "Foreground time per hour of the 8 apps used most in the selected range.",
      "id": 12,
      "gridPos": {
        "x": 10,
        "y": 15,
        "w": 14,
        "h": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (activity_app_name) (increase(activity_app_time_seconds_total{job=\"activitylog/activitylog-android\", instance=~\"$device\"}[$__interval])) and on (activity_app_name) topk(8, sum by (activity_app_name) (increase(activity_app_time_seconds_total{job=\"activitylog/activitylog-android\", instance=~\"$device\"}[$__range] @ end())))",
          "legendFormat": "{{activity_app_name}}",
          "range": true,
          "instant": false,
          "interval": "1h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "barAlignment": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never",
            "axisSoftMin": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1h"
    },
    {
      "type": "timeseries",
      "title": "Unlocks per hour",
      "description": "Device unlocks per hour.",
      "id": 13,
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(increase(activity_device_unlocks_total{job=\"activitylog/activitylog-android\", instance=~\"$device\"}[$__interval]))",
          "legendFormat": "unlocks",
          "range": true,
          "instant": false,
          "interval": "1h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "barAlignment": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never",
            "axisSoftMin": 0
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "interval": "1h"
    },
    {
      "type": "timeseries",
      "title": "App switches per hour",
      "description": "activity.app.switch events per hour.",
      "id": 14,
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(count_over_time({service_name=\"activitylog-android\", service_instance_id=~\"${device:pipe}\"} | event_name=\"activity.app.switch\" [$__interval]))",
          "queryType": "range",
          "legendFormat": "switches"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "barAlignment": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never",
            "axisSoftMin": 0
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
