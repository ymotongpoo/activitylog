    },
    {
      "type": "row",
      "title": "Location",
      "id": 15,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "geomap",
      "title": "Route",
      "description": "device.location logs from the Android app, connected in time order. Structured metadata geo_location_lat/lon are extracted from the log labels.",
      "id": 16,
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 16,
        "h": 16
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "refId": "A",
          "editorMode": "code",
          "expr": "{service_name=\"activitylog-android\", service_instance_id=~\"${device:pipe}\"} | event_name=\"device.location\"",
          "queryType": "range",
          "maxLines": 5000
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "view": {
          "id": "fit",
          "lat": 0,
          "lon": 0,
          "zoom": 12,
          "allLayers": true
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true,
          "showAttribution": true
        },
        "basemap": {
          "type": "default",
          "name": "Basemap"
        },
        "layers": [
          {
            "type": "route",
            "name": "Route",
            "tooltip": true,
            "location": {
              "mode": "coords",
              "latitude": "geo_location_lat",
              "longitude": "geo_location_lon"
            },
            "config": {
              "arrow": 0,
              "style": {
                "color": {
                  "fixed": "#5794F2"
                },
                "lineWidth": 2,
                "opacity": 0.8,
                "size": {
                  "fixed": 3,
                  "min": 2,
                  "max": 6
                }
              }
            }
          }
        ],
        "tooltip": {
          "mode": "details"
        }
      },
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "auto",
            "replace": false,
            "keepTime": false
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "geo_location_lat",
                "destinationType": "number"
              },
              {
                "targetField": "geo_location_lon",
                "destinationType": "number"
              },
              {
                "targetField": "activity_location_accuracy",
                "destinationType": "number"
              }
            ]
