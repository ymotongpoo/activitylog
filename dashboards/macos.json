          },
          "refId": "A",
          "editorMode": "code",
          "expr": "sort_desc(topk(15, sum by (activity_editor_project) (increase(activity_editor_project_time_seconds_total{job=\"activitylog/activitylog-agent\", instance=~\"$device\"}[$__range]))))",
          "legendFormat": "{{activity_editor_project}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "continuous-BlPu"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "text",
        "showUnfilled": true,
        "namePlacement": "left",
        "sizing": "manual",
        "minVizHeight": 16,
        "maxVizHeight": 24,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "piechart",
      "title": "Languages",
