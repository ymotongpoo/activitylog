  "title": "睡眠 · Health Connect",
  "uid": "activitylog-sleep",
  "description": "Garmin ConnectからHealth Connectへ同期された睡眠セッションと段階。訂正された記録は最新の内容で集計します。",
  "version": 2,
  "time": {
    "from": "now-28d",
    "to": "now"
  },
  "refresh": "5m",
  "templating": {
    "list": [
      {
        "name": "loki",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 2,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 1,
        "regex": "/^grafanacloud-.+-logs$/",
        "skipUrlSync": false
      },
      {
        "name": "phone",
        "label": "スマホ",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "${loki}"
        },
        "query": {
          "label": "service_instance_id",
          "stream": "{service_name=\"activitylog-android\",service_namespace=\"activitylog\"}",
          "type": 1
        },
        "current": {},
        "hide": 0,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "options": [],
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "睡眠セッション数",
      "type": "stat",
      "description": "選択した取り込み期間の各セッションについて最新の訂正内容を選び、合計します。睡眠が起きた期間とは異なる場合があります。",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "editorMode": "code",
          "expr": "sum(last_over_time({service_name=\"activitylog-android\",service_namespace=\"activitylog\",service_instance_id=~\"${phone:regex}\"} | event_name=\"sleep.session\" | json value=\"session_count\", id=\"session_id\" | unwrap value | __error__=\"\" [$__range]) by (id, service_instance_id))",
          "queryType": "instant",
          "legendFormat": "",
          "maxLines": 5000
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "decimals": 0,
          "noValue": "No data",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true
      }
