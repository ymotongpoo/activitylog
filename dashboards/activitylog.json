      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 5
      },
      "interval": "1h",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "refId": "A",
          "expr": "sum by (instance) (increase(activity_time_seconds_total{activity_state=\"active\", instance=~\"$instance\", job=~\"activitylog/.*\"}[1h]))",
          "legendFormat": "{{instance}}",
          "range": true,
          "instant": false,
